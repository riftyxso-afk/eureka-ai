{
  "manifest_version": 3,
  "name": "Eureka.AI — Socratic Tutor",
  "short_name": "Eureka",
  "version": "0.1.0",
  "description": "Tanya Eureka dari halaman mana pun: highlight teks untuk dialog Socratic, atau simpan tab jadi catatan.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "contextMenus", "sidePanel", "storage", "scripting"],
  "host_permissions": ["https://eureka-ai.web.id/*", "http://localhost:3000/*", "http://localhost:3001/*"],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Eureka.AI",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
