# ============================================
# Eureka.AI — Konfigurasi AI (multi-provider, semua OpenAI-compatible)
# ============================================

# Provider: "openagentic" (default) | "aimurah" | "openai"
AI_PROVIDER=openagentic

# ---------- OpenAgentic (openagentic.id) ----------
# Satu key untuk 37+ model premium. Daftar & buat key (sk-) di https://openagentic.id
OPENAGENTIC_API_KEY=
OPENAGENTIC_BASE_URL=https://openagentic.id/api/v1
OPENAGENTIC_MODEL=claude-sonnet-4.5

# ---------- AIMurah ----------
# Daftar & buat API key di https://aimurah.my.id
AI_API_KEY=
AI_BASE_URL=https://aimurah.my.id/api/v1
# FREE: claude-sonnet-4.5, claude-haiku-4.5, deepseek-3.2, minimax-m2.5
AI_MODEL=deepseek-v4-flash

# ---------- OpenAI resmi (opsional) ----------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ---------- OpenRouter (fallback otomatis saat provider utama down) ----------
# Daftar & buat key (sk-or-) di https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# ---------- Juan Router (fallback terakhir) ----------
# Gateway OpenAI-compatible (Claude/Gemini/dll): https://router.juan.web.id
# Buat token di Dashboard → API Keys; model gratis: ling-3.0-flash-free
JUANROUTER_API_KEY=
JUANROUTER_BASE_URL=https://router.juan.web.id/v1
JUANROUTER_MODEL=ling-3.0-flash-free

# ---------- Firecrawl (opsional, untuk web search & scrape) ----------
# Dipakai untuk: membuat catatan dari link web, validasi & enrichment
# per-bab (mencari fakta pendukung di web, maks 5 sumber per catatan).
# Daftar & buat API key di https://firecrawl.dev
FIRECRAWL_API_KEY=

# ---------- Resend (kirim email kode OTP verifikasi akun/login) ----------
# Daftar & buat API key (awalan re_) di https://resend.com/api-keys
# Sampai domain diverifikasi, email dikirim dari onboarding@resend.dev
# (hanya boleh mengirim ke email akun sendiri). Setelah verifikasi domain,
# isi RESEND_FROM_EMAIL, mis: Eureka.AI <noreply@domainmu.com>
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ---------- Backend terpisah (opsional) ----------
# URL backend API mandiri, mis. "https://api.eureka-ai.web.id".
# Kosongkan = API pada domain yang sama (frontend + API satu server).
NEXT_PUBLIC_API_URL=

# ---------- Cloudflare Workers AI (generate gambar, opsional) ----------
# Dipakai untuk: (1) ilustrasi dokumen PDF, (2) "Eureka Draw" di /home & /chat
# saat user minta "buatkan gambar ..." (FLUX text-to-image).
# Bebas biaya: 10.000 neurons/hari (Workers Free, tanpa kartu kredit).
# CLOUDFLARE_ACCOUNT_ID: dashboard Cloudflare → pojok kanan bawah "Account ID".
# CLOUDFLARE_API_TOKEN:  My Profile → API Tokens → Create Token →
#                        template "Workers AI" (izin Workers AI:Run).
# Model: flux-2-klein-4b (utama) → flux-1-schnell (fallback).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ---------- Pakasir payment gateway (langganan Pro) ----------
# Payment gateway pengganti DOKU. Buat proyek di https://app.pakasir.com →
# catat Slug & API Key proyek (dok: pakasir.com/p/docs).
# PAKASIR_PROJECT: slug proyek (mis. eureka-ai)
# PAKASIR_API_KEY: API key proyek (dipakai verifikasi transactiondetail)
# PAKASIR_REDIRECT_URL: URL kembali setelah bayar — netral, TIDAK mengklaim hasil
# (Pakasir hanya redirect setelah bayar sukses). Default: /dashboard?upgrade=done
# Popup sukses hanya muncul bila server mengonfirmasi premium aktif.
# Jangan lupa isi Webhook URL proyek di dashboard Pakasir:
#   https://<domainmu>/api/payments/webhook
PAKASIR_PROJECT=
PAKASIR_API_KEY=
PAKASIR_REDIRECT_URL=
