# ============================================
# Eureka.AI — Konfigurasi AI (multi-provider, semua OpenAI-compatible)
# ============================================
# ATURAN ROUTING (juan-router-provider-split, 2026-09-04):
# - SEMUA generate TEKS (chat, catatan, kuis, judul, dll) → Juan Router,
#   fallback darurat OpenRouter. JUANROUTER_API_KEY = WAJIB untuk fitur teks.
# - OpenAgentic → KHUSUS text-to-image (Eureka Draw & ilustrasi).
#   Tanpa OPENAGENTIC_API_KEY hanya fitur gambar yang nonaktif.
# - Embedding & transkripsi → belum tersedia di Juan Router; mengikuti
#   AI_PROVIDER (default openagentic).

# Provider untuk embedding/transkripsi & getAiApiConfig():
# "openagentic" (default) | "aimurah" | "openai" | "openrouter" | "9router"
AI_PROVIDER=openagentic

# ---------- Juan Router — WAJIB untuk semua generate teks ----------
# Gateway OpenAI-compatible (Gemini/GPT/Grok/dll): https://router.juan.web.id
# Buat token di Dashboard → API Keys. Tier model per mode kecepatan ada di
# lib/ai.ts (SPEED_MODEL_LISTS) — hanya model yang hidup di router.
JUANROUTER_API_KEY=sk-xxxx-xxxx-xxxx
JUANROUTER_BASE_URL=https://router.juan.web.id/v1
JUANROUTER_MODEL=gemini-3.7-flash-low

# ---------- OpenRouter — fallback DARURAT teks ----------
# Hanya dipakai bila SELURUH model Juan Router gagal (429/503/timeout).
# Daftar & buat key (sk-or-) di https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxx-xxxx-xxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# ---------- OpenAgentic (openagentic.id) — KHUSUS text-to-image ----------
# Tidak dipakai untuk teks. Model gambar default ali-qwen-image-2.0-pro,
# bisa diganti via OPENAGENTIC_IMAGE_MODEL tanpa deploy kode.
OPENAGENTIC_API_KEY=sk-xxxx-xxxx-xxxx
OPENAGENTIC_BASE_URL=https://openagentic.id/api/v1
OPENAGENTIC_MODEL=claude-sonnet-4.5
# OPENAGENTIC_IMAGE_MODEL=ali-qwen-image-2.0-pro

# Override model-terpaksa (debug): DINONAKTIFKAN untuk teks — semua teks
# lewat Juan Router. Diisi pun diabaikan (lihat log peringatan).
# AI_FORCE_MODELS=

# ---------- AIMurah ----------
# Daftar & buat API key di https://aimurah.my.id
AI_API_KEY=sk-xxxx-xxxx-xxxx
AI_BASE_URL=https://aimurah.my.id/api/v1
# FREE: claude-sonnet-4.5, claude-haiku-4.5, deepseek-3.2, minimax-m2.5
AI_MODEL=deepseek-v4-flash

# ---------- OpenAI resmi (opsional) ----------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ---------- Firecrawl (opsional, untuk web search & scrape) ----------
# Dipakai untuk: membuat catatan dari link web, validasi & enrichment
# per-bab (mencari fakta pendukung di web, maks 5 sumber per catatan).
# Daftar & buat API key di https://firecrawl.dev
FIRECRAWL_API_KEY=fc-xxxx-xxxx-xxxx

# ---------- Resend (kirim email kode OTP verifikasi akun/login) ----------
# Daftar & buat API key (awalan re_) di https://resend.com/api-keys
# Sampai domain diverifikasi, email dikirim dari onboarding@resend.dev
# (hanya boleh mengirim ke email akun sendiri). Setelah verifikasi domain,
# isi RESEND_FROM_EMAIL, mis: Eureka.AI <noreply@domainmu.com>
RESEND_API_KEY=re_xxxx_xxxx_xxxx
RESEND_FROM_EMAIL=

# ---------- Backend terpisah (opsional) ----------
# URL backend API mandiri, mis. "https://api.eureka-ai.web.id".
# Kosongkan = API pada domain yang sama (frontend + API satu server).
NEXT_PUBLIC_API_URL=

# ---------- Cloudflare Workers AI (generate gambar, opsional) ----------
# Dipakai untuk: (1) ilustrasi dokumen PDF, (2) "Eureka Draw" di /home & /chat
# saat user minta "buatkan gambar ..." (FLUX text-to-image).
# Bebas biaya: 10.000 neurons/hari (Workers Free, tanpa kartu kredit).
# CLOUDFLARE_ACCOUNT_ID: dashboard Cloudflare → pojok kanan bawah "Account ID".
# CLOUDFLARE_API_TOKEN:  My Profile → API Tokens → Create Token →
#                        template "Workers AI" (izin Workers AI:Run).
# Model: flux-2-klein-4b (utama) → flux-1-schnell (fallback).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ---------- Pakasir payment gateway (langganan Pro) ----------
# Payment gateway pengganti DOKU. Buat proyek di https://app.pakasir.com →
# catat Slug & API Key proyek (dok: pakasir.com/p/docs).
# PAKASIR_PROJECT: slug proyek (mis. eureka-ai)
# PAKASIR_API_KEY: API key proyek (dipakai verifikasi transactiondetail)
# PAKASIR_REDIRECT_URL: URL kembali setelah bayar — netral, TIDAK mengklaim hasil
# (Pakasir hanya redirect setelah bayar sukses). Default: /dashboard?upgrade=done
# Popup sukses hanya muncul bila server mengonfirmasi premium aktif.
# Jangan lupa isi Webhook URL proyek di dashboard Pakasir:
#   https://<domainmu>/api/payments/webhook
PAKASIR_PROJECT=
PAKASIR_API_KEY=
PAKASIR_REDIRECT_URL=

# ---------- Eureka Multi Agent (openspec: eureka-multi-agent-system) ----------
# Feature flag master untuk sistem multi-agent (6 agent + mode loop).
# Kosong/0 = fitur disembunyikan; "1" = aktif. Per-user flag di Tahap 2.
FEATURE_MULTI_AGENT=

# Flag khusus Solve-then-Guide (fitur Pro, Tahap 4) — terpisah agar bisa
# dirilis bertahap tanpa menyalakan seluruh sistem agent.
FEATURE_SOLVE_THEN_GUIDE=

# Id model Astra untuk Solve-then-Guide (mahal: hanya dipanggil kondisional).
# Kosong = Astra nonaktif → Solve-then-Guide memakai rantai Socra-Mendalam.
# Contoh: gpt-6-astra (cek ketersediaan di Juan Router dulu).
AGENT_ASTRA_MODEL=

# Override model per agent (opsional — default ada di lib/agents/catalog.ts).
# AGENT_KOMPAS_MODEL=glm-5.3-flash
# AGENT_SOCRA_MODEL=claude-opus-5
# AGENT_LENSA_MODEL=
# AGENT_JEJAK_MODEL=
# AGENT_PALET_MODEL=
# AGENT_KILAU_MODEL=glm-5.3-flash

# Guardrail loop multi-agent.
# Max iterasi per topik (default 6).
AGENT_LOOP_MAX_ITERATIONS=6
# Cap biaya harian per user, dalam ribu token gabungan (in+out):
# loop biasa (semua agent) dan panggilan Astra — DUA bucket terpisah.
AGENT_LOOP_DAILY_TOKEN_CAP=500
AGENT_ASTRA_DAILY_TOKEN_CAP=100

# ---------- Sandbox eksekusi kode (Solve-then-Guide, Tahap 4) ----------
# Provider pertama: E2B (e2b.dev) — free tier. Kunci API dari dashboard.
E2B_API_KEY=
# Limit per eksekusi (configurable; default 10 detik / 256MB).
SANDBOX_TIMEOUT_SECONDS=10
SANDBOX_MEMORY_MB=256
# Whitelist bahasa, dipisah koma. Mulai Python saja.
SANDBOX_LANGUAGES=python
